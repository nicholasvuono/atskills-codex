# Dependencies and package-manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
/coverage/
/.nyc_output/

# Generated build output and temporary files
/build/
/dist/
/.tmp/
/tmp/
*.swp

# Temporary upstream refresh checkouts
/upstream/
/.upstream/

# TypeScript output for maintainer-only sources and tests
/scripts/*.js
/test/*.test.js

# Per-workspace AtSkills state
/.atskills/

# Local operating-system files
.DS_Store
